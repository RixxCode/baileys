{
  "name": "@rixxcodexyz/baileys",
  "version": "8.0.15",
  "description": "Websocket Whatsapp API for Node.js",
  "keywords": [
    "whatsapp",
    "websocket",
    "api",
    "nodejs",
    "baileys",
    "wabot",
    "proto",
    "whatsapp-websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixxcode/baileys.git"
  },
  "license": "MIT",
  "author": "RixxCode",
  "main": "./lib/index.js",
  "files": [
    "lib/*",
    "WAProto/*"
  ],
  "scripts": {
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "example": "node --inspect Example/example.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "yarn lint --fix",
    "release": "release-it",
    "test": "jest"
  },
  "dependencies": {
    "@cacheable/node-cache": "*",
    "@hapi/boom": "*",
    "async-mutex": "*",
    "axios": "*",
    "figlet": "*",
    "gradient-string": "2.0.2",
    "lodash": "*",
    "long": "5.2.3",
    "lru-cache": "*",
    "moment-timezone": "*",
    "music-metadata": "*",
    "p-queue": "*",
    "pino": "*",
    "protobufjs": "*",
    "ws": "*",
    "jimp": "0.22.12",
    "cache-manager": "5.7.6",
    "@rixxcodexyz/libsignal": "github:RixxCode/libsignal"
  },
  "devDependencies": {
    "@types/jest": "*",
    "@types/node": "*",
    "@types/ws": "*",
    "cache-manager": "^5.7.6",
    "conventional-changelog-cli": "*",
    "eslint": "*",
    "jest": "*",
    "json": "*",
    "link-preview-js": "*",
    "open": "*",
    "protobufjs-cli": "*",
    "release-it": "*",
    "pbjs": "^0.0.14"
  },
  "peerDependencies": {
    "audio-decode": "*",
    "jimp": "^0.22.12",
    "link-preview-js": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "chalk": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.0.0"
  },
  "directories": {
    "lib": "lib"
  },
  "bugs": {
    "url": "https://github.com/rixxcode/baileys/issues"
  }
}